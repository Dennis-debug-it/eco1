# HTTPS in front of Ecosys Payroll. Caddy obtains and renews a Let's Encrypt certificate for $DOMAIN
# automatically; the domain's DNS A record must point at this server and ports 80/443 must be open.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy payroll:8080 {
		header_up X-Forwarded-Proto {scheme}
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}
