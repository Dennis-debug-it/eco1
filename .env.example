# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64:  openssl rand -base64 32
PAYROLL_ENCRYPTION_KEY=
# Local auth signing key (≥ 32 chars). Not used when AUTH_MODE=Ecosys.
AUTH_SIGNING_KEY=
# Local | Ecosys (shared Ecosys identity provider)
AUTH_MODE=Local
AUTH_AUTHORITY=
AUTH_AUDIENCE=ecosys-payroll
# Seed the "demo" tenant (Savanna Logistics) with sample data. Never in production.
SEED_DEMO_DATA=false
# Must also be true for demo data to load: the app refuses demo data in Production otherwise.
ALLOW_DEMO_DATA=false
# Log | Ecosys
NOTIFICATIONS_PROVIDER=Log
NOTIFICATIONS_BASE_URL=
NOTIFICATIONS_API_KEY=
PORTAL_URL=http://localhost:8080

# ---- SaaS (many customers on one server; see section 9 of docs/operations.md) ----
# false = licensed install for one employer: no sign-up page, plans or billing.
SAAS_ENABLED=false
# Self-service sign-up from the sign-in page. Needs NOTIFICATIONS_PROVIDER=Ecosys (confirmation emails).
SAAS_SIGNUP_ENABLED=true
SAAS_TRIAL_DAYS=14
# Days after an invoice's due date before the account becomes read-only.
SAAS_GRACE_DAYS=7
SAAS_INVOICE_DUE_DAYS=14
# VAT on subscription invoices (Kenya standard rate).
SAAS_VAT_RATE=0.16
# Printed on invoices.
SAAS_SELLER_NAME=
SAAS_SELLER_TAX_PIN=
SAAS_SELLER_ADDRESS=
SAAS_SUPPORT_EMAIL=
# e.g. "M-Pesa Paybill 123456 (account: invoice number) or EFT to Bank X, account 0123456789."
SAAS_PAYMENT_INSTRUCTIONS=

# ---- Production (docker-compose.prod.yml) ----
# Public host name; its DNS A record must point at this server. Caddy gets the TLS certificate.
DOMAIN=
ACME_EMAIL=

# ---- Backups ----
# Encrypts every backup (AES-256). Store it in a password manager AND somewhere off this server:
# without it the backups can't be restored. Generate with: openssl rand -base64 32
BACKUP_PASSPHRASE=
BACKUP_AT=01:30
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=12
# Host folder for backups; sync it off-site (another server or object storage), ideally in Kenya.
BACKUP_PATH=./backups

# ---- Data protection ----
# Years to keep former employees' records before anonymisation (minimum 5).
RETENTION_EMPLOYEE_YEARS=7
