{
  "ConnectionStrings": {
    "Payroll": "Host=localhost;Port=5432;Database=ecosys_payroll;Username=postgres;Password=postgres"
  },
  "Payroll": {
    "MigrateOnStartup": true,
    "SeedDemoData": false,
    "Encryption": {
      "Key": ""
    }
  },
  "Auth": {
    "Mode": "Local",
